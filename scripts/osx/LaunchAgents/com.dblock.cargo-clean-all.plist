<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.dblock.cargo-clean-all</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/dblock/.cargo/bin/cargo-clean-all</string>
    <string>--yes</string>
    <string>--keep-days</string>
    <string>7</string>
    <string>/Users/dblock/source</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key>
    <integer>0</integer>
    <key>Hour</key>
    <integer>3</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/dblock/Library/Logs/cargo-clean-all.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/dblock/Library/Logs/cargo-clean-all.error.log</string>
</dict>
</plist>
